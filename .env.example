PROJECT_NAME="FastAPI TaskHub"
DEBUG=True
# Set to True in local development to expose /docs, /redoc, and /openapi.json.
ENABLE_DOCS=False
API_V1_STR="/api/v1"
JWT_PRIVATE_KEY_PATH=".keys/private.pem"
JWT_PUBLIC_KEY_PATH=".keys/public.pem"
JWT_KEY_ID="taskhub-1"
JWT_ISSUER="taskhub"
JWT_AUDIENCE="taskhub-api"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL="mysql+aiomysql://root:your_mysql_password@localhost:3306/taskhub_db?charset=utf8mb4"
# Leave empty to disable Redis caching.
REDIS_URL=""
TASK_LIST_CACHE_TTL_SECONDS=60
REDIS_SOCKET_TIMEOUT_SECONDS=0.25
# Leave SMTP_HOST empty to log task assignment notifications without sending email.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@taskhub.local"
SMTP_USE_TLS=True
SMTP_TIMEOUT_SECONDS=5.0
